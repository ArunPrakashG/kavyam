# Kavyam OpenType features. Included by every UFO via features.fea.

languagesystem DFLT dflt;
languagesystem latn dflt;
languagesystem mlm2 dflt;   # current Malayalam script tag
languagesystem mlym dflt;   # legacy tag, for older shapers

# Hand-written Malayalam shaping features (script-wide, orthography-neutral).

# Legacy chillu spelling: consonant + virama + ZWJ  ->  atomic chillu (U+0D7A..7F)
feature akhn {
    lookup chillu_legacy {
        sub ml_nna ml_sign_virama zwj by ml_chillu_nn;
        sub ml_na  ml_sign_virama zwj by ml_chillu_n;
        sub ml_ra  ml_sign_virama zwj by ml_chillu_rr;
        sub ml_la  ml_sign_virama zwj by ml_chillu_l;
        sub ml_lla ml_sign_virama zwj by ml_chillu_ll;
        sub ml_ka  ml_sign_virama zwj by ml_chillu_k;
    } chillu_legacy;
} akhn;

# Ra sign (consonant + virama + RA): drawn to the LEFT of the consonant.
feature pref {
    sub ml_sign_virama ml_ra by ml_ra_sign;
} pref;

# Ya / va signs (consonant + virama + YA/VA): post-base forms.
feature pstf {
    sub ml_sign_virama ml_ya by ml_ya_sign;
    sub ml_sign_virama ml_va by ml_va_sign;
} pstf;

# GENERATED by tools/gen_features.py from data/ - do not edit by hand.

feature akhn {
    lookup modern_akhn {
        sub ml_ka ml_sign_virama ml_ssa by ml_ka_ssa;  # ക്ഷ
        sub ml_ja ml_sign_virama ml_nya by ml_ja_nya;  # ജ്ഞ
    } modern_akhn;
} akhn;

feature cjct {
    lookup modern_cjct {
        sub ml_ka ml_sign_virama ml_ka by ml_ka_ka;  # ക്ക
        sub ml_ga ml_sign_virama ml_ga by ml_ga_ga;  # ഗ്ഗ
        sub ml_ca ml_sign_virama ml_ca by ml_ca_ca;  # ച്ച
        sub ml_ja ml_sign_virama ml_ja by ml_ja_ja;  # ജ്ജ
        sub ml_nya ml_sign_virama ml_nya by ml_nya_nya;  # ഞ്ഞ
        sub ml_tta ml_sign_virama ml_tta by ml_tta_tta;  # ട്ട
        sub ml_dda ml_sign_virama ml_dda by ml_dda_dda;  # ഡ്ഡ
        sub ml_nna ml_sign_virama ml_nna by ml_nna_nna;  # ണ്ണ
        sub ml_ta ml_sign_virama ml_ta by ml_ta_ta;  # ത്ത
        sub ml_da ml_sign_virama ml_da by ml_da_da;  # ദ്ദ
        sub ml_pa ml_sign_virama ml_pa by ml_pa_pa;  # പ്പ
        sub ml_ba ml_sign_virama ml_ba by ml_ba_ba;  # ബ്ബ
        sub ml_ma ml_sign_virama ml_ma by ml_ma_ma;  # മ്മ
        sub ml_la ml_sign_virama ml_la by ml_la_la;  # ല്ല
        sub ml_lla ml_sign_virama ml_lla by ml_lla_lla;  # ള്ള
        sub ml_sha ml_sign_virama ml_sha by ml_sha_sha;  # ശ്ശ
        sub ml_ssa ml_sign_virama ml_ssa by ml_ssa_ssa;  # ഷ്ഷ
        sub ml_sa ml_sign_virama ml_sa by ml_sa_sa;  # സ്സ
        sub ml_rra ml_sign_virama ml_rra by ml_rra_rra;  # റ്റ
        sub ml_na ml_sign_virama ml_na by ml_na_na;  # ന്ന
        sub ml_nga ml_sign_virama ml_ka by ml_nga_ka;  # ങ്ക
        sub ml_nga ml_sign_virama ml_nga by ml_nga_nga;  # ങ്ങ
        sub ml_nya ml_sign_virama ml_ca by ml_nya_ca;  # ഞ്ച
        sub ml_nya ml_sign_virama ml_ja by ml_nya_ja;  # ഞ്ജ
        sub ml_nna ml_sign_virama ml_tta by ml_nna_tta;  # ണ്ട
        sub ml_nna ml_sign_virama ml_ttha by ml_nna_ttha;  # ണ്ഠ
        sub ml_nna ml_sign_virama ml_dda by ml_nna_dda;  # ണ്ഡ
        sub ml_na ml_sign_virama ml_ta by ml_na_ta;  # ന്ത
        sub ml_na ml_sign_virama ml_tha by ml_na_tha;  # ന്ഥ
        sub ml_na ml_sign_virama ml_da by ml_na_da;  # ന്ദ
        sub ml_na ml_sign_virama ml_dha by ml_na_dha;  # ന്ധ
        sub ml_na ml_sign_virama ml_rra by ml_na_rra;  # ന്റ
        sub ml_ma ml_sign_virama ml_pa by ml_ma_pa;  # മ്പ
        sub ml_ta ml_sign_virama ml_tha by ml_ta_tha;  # ത്ഥ
        sub ml_da ml_sign_virama ml_dha by ml_da_dha;  # ദ്ധ
    } modern_cjct;
} cjct;


# GENERATED by tools/gen_features.py from data/ - do not edit by hand.

feature ss01 {
    featureNames {
        name "Traditional lipi (preview)";
    };
    lookup trad_new {
        sub ml_ka ml_sign_virama ml_ta by ml_ka_ta.trad;  # ക്ത
        sub ml_na ml_sign_virama ml_ma by ml_na_ma.trad;  # ന്മ
        sub ml_ta ml_sign_virama ml_ma by ml_ta_ma.trad;  # ത്മ
        sub ml_la ml_sign_virama ml_pa by ml_la_pa.trad;  # ല്പ
        sub ml_la ml_sign_virama ml_ka by ml_la_ka.trad;  # ല്ക
        sub ml_nna ml_sign_virama ml_ma by ml_nna_ma.trad;  # ണ്മ
        sub ml_sha ml_sign_virama ml_ca by ml_sha_ca.trad;  # ശ്ച
    } trad_new;
    lookup trad_alt {
        sub ml_ka_ka by ml_ka_ka.trad;  # ക്ക
        sub ml_nga_ka by ml_nga_ka.trad;  # ങ്ക
        sub ml_nna_tta by ml_nna_tta.trad;  # ണ്ട
        sub ml_na_ta by ml_na_ta.trad;  # ന്ത
        sub ml_na_rra by ml_na_rra.trad;  # ന്റ
        sub ml_pa_pa by ml_pa_pa.trad;  # പ്പ
        sub ml_sha_sha by ml_sha_sha.trad;  # ശ്ശ
        sub ml_ka_ssa by ml_ka_ssa.trad;  # ക്ഷ
    } trad_alt;
} ss01;

